# Copy to .env and fill in only what you use. No tool prints these.

# RunPod (renting GPUs with the default --on runpod)
RUNPOD_API_KEY=

# Vast.ai keeps its own key: run `vastai set api-key YOUR_KEY` once.

# podcasts/publish.py: any S3-compatible bucket that is public to read
PODCAST_S3_ENDPOINT=
PODCAST_S3_BUCKET=
PODCAST_S3_KEY_ID=
PODCAST_S3_SECRET=
PODCAST_BASE_URL=https://podcasts.example.com
